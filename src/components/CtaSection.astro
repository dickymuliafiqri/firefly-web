---
---

<section
  class="cta-section max-w-[1080px] mx-auto px-4 sm:px-6 pt-14 sm:pt-16 md:pt-[12vh] pb-16 md:pb-[14vh] scroll-mt-20 md:scroll-mt-8"
  id="get-started"
  aria-label="Get started with Firefly"
>
  <div
    class="relative rounded-2xl border border-white/10 bg-[rgba(6,13,29,0.7)] backdrop-blur-md p-5 sm:p-8 md:p-12 overflow-hidden"
  >
    <div class="relative z-10 max-w-[640px]">
      <p
        class="font-mono text-[11.5px] tracking-[0.2em] uppercase text-biolum-aura opacity-85 mb-3"
      >
        Single binary &middot; MIT licensed
      </p>
      <h2
        class="font-display font-medium text-[clamp(28px,3.6vw,44px)] tracking-[-0.01em] mb-4 text-ink"
      >
        Light up your gateway.
      </h2>
      <p class="text-muted leading-[1.7] text-[15.5px] mb-8">
        Drop Firefly in front of your OpenAI, Anthropic, or local Ollama instances.
        No database required, zero runtime dependencies, and high concurrency
        powered by Go.
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 mb-6 sm:mb-8">
        <a
          href="https://github.com/dickymuliafiqri/firefly#quick-start"
          target="_blank"
          rel="noopener"
          class="btn text-center inline-block px-[24px] py-[12px] rounded-full bg-biolum-aura text-[#0a1220] font-semibold text-[14px] no-underline transition-all hover:bg-biolum-glow hover:-translate-y-[1px]"
        >
          Get Started on GitHub &rarr;
        </a>
        <a
          href="https://github.com/dickymuliafiqri/firefly/blob/main/README.md"
          target="_blank"
          rel="noopener"
          class="btn ghost text-center inline-block px-[24px] py-[12px] rounded-full border border-white/15 text-ink text-[14px] no-underline transition-colors hover:border-white/30"
        >
          View Documentation
        </a>
      </div>

      <pre
        class="term font-mono text-[11.5px] sm:text-[12.5px] leading-[1.8] text-[#b6c4de] bg-[rgba(3,8,18,0.85)] border border-white/10 rounded-[10px] px-3.5 sm:px-5 py-3 sm:py-4 whitespace-pre-wrap break-all w-full overflow-x-auto"
        aria-label="Quick start command"><span class="text-faint"># run via docker or grab the binary</span>
docker run -p 8080:8080 ghcr.io/dickymuliafiqri/firefly:latest</pre>
    </div>
  </div>
</section>

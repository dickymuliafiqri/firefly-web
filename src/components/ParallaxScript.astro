<script>
  function initParallax() {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reducedMotion) return;

    const depthEls = Array.from(document.querySelectorAll<HTMLElement>("[data-depth]"));
    if (depthEls.length === 0) return;

    const mouse = { x: 0, y: 0 };
    const cur = { x: 0, y: 0 };

    window.addEventListener(
      "mousemove",
      (e) => {
        mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
        mouse.y = (e.clientY / window.innerHeight) * 2 - 1;
      },
      { passive: true },
    );

    function applyParallax() {
      cur.x += (mouse.x - cur.x) * 0.06;
      cur.y += (mouse.y - cur.y) * 0.06;

      const scroll = window.scrollY || 0;
      const docMax = document.documentElement.scrollHeight - window.innerHeight;
      const pageProgress = docMax > 0 ? Math.min(scroll / docMax, 1) : 0;

      for (const el of depthEls) {
        const d = parseFloat(el.getAttribute("data-depth") || "0");
        const mx = cur.x * d;
        const my = cur.y * d * 0.55;
        let scale = 1;
        let sc = 0;

        if (el.classList.contains("moon")) {
          sc = -Math.min(scroll * 0.1, 90);
          scale = 1 + 0.7 * pageProgress;
        } else if (el.classList.contains("stars")) {
          sc = -Math.min(scroll * 0.045, 40);
        } else if (el.closest(".scenery")) {
          const zone = el.closest(".forest-zone");
          if (zone) {
            const rect = zone.getBoundingClientRect();
            const stuck = rect.bottom > window.innerHeight - 4;
            if (stuck) {
              sc = Math.min(scroll * 0.018, 26) * (d / 27);
            }
          }
        }

        el.style.transform = `translate3d(${mx.toFixed(2)}px, ${(my + sc).toFixed(2)}px, 0) scale(${scale.toFixed(4)})`;
      }
      requestAnimationFrame(applyParallax);
    }

    requestAnimationFrame(applyParallax);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initParallax);
  } else {
    initParallax();
  }
</script>

---
import { providers } from "@/data/providers";
---
<section class="section max-w-[1080px] mx-auto px-4 sm:px-6 pt-16 sm:pt-20 md:pt-[14vh] pb-8 md:pb-[6vh] scroll-mt-20 md:scroll-mt-8" id="providers">
  <h2 class="font-display font-medium text-[clamp(30px,4vw,46px)] tracking-[-0.01em] mb-4">Speaks to your providers.</h2>
  <p class="max-w-[620px] text-muted leading-[1.7] text-[16px] mb-7 sm:mb-12">
    One endpoint, wire-compatible with OpenAI, in front of your providers.
    Adapters translate, authenticate and stream natively, with no glue code and no env juggling.
  </p>
  <div class="providers-row flex flex-wrap items-start justify-between gap-y-9 gap-x-7 pt-3 max-md:justify-center">
    {
      providers.map((provider) => (
        <figure class="flex flex-col items-center gap-3 min-w-[86px] group">
          <svg
            viewBox="0 0 24 24"
            class="w-10 h-10 fill-[#8fa3c7] transition-all group-hover:fill-biolum-glow group-hover:-translate-y-[3px]"
          >
            <path d={provider.path} />
          </svg>
          <figcaption class="text-[12.5px] text-faint tracking-[0.04em] group-hover:text-muted transition-colors">
            {provider.name}
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

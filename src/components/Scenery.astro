---
// Scenery layers rendered from coordinate tables so the forest stays
// data-driven instead of thousands of hand-placed SVG nodes.
//
// Pine variants: 2 = two canopy polygons, 3 = three canopy polygons.
type Pine = { kind: "pine"; x: number; y: number; s: number; v: 2 | 3 };
type Blob = { kind: "blob"; x: number; y: number; s: number };

const backTrees: Pine[] = [
  { kind: "pine", x: 70, y: 310, s: 0.62, v: 3 },
  { kind: "pine", x: 160, y: 304, s: 0.5, v: 2 },
  { kind: "pine", x: 255, y: 312, s: 0.72, v: 3 },
  { kind: "pine", x: 360, y: 300, s: 0.55, v: 2 },
  { kind: "pine", x: 455, y: 306, s: 0.68, v: 3 },
  { kind: "pine", x: 560, y: 302, s: 0.5, v: 2 },
  { kind: "pine", x: 650, y: 310, s: 0.75, v: 3 },
  { kind: "pine", x: 760, y: 300, s: 0.52, v: 2 },
  { kind: "pine", x: 850, y: 308, s: 0.66, v: 3 },
  { kind: "pine", x: 950, y: 304, s: 0.56, v: 2 },
  { kind: "pine", x: 1050, y: 310, s: 0.7, v: 3 },
  { kind: "pine", x: 1160, y: 302, s: 0.5, v: 2 },
  { kind: "pine", x: 1250, y: 310, s: 0.68, v: 3 },
  { kind: "pine", x: 1360, y: 304, s: 0.58, v: 2 },
];

const midTrees: Array<Pine | Blob> = [
  { kind: "pine", x: 120, y: 292, s: 1.15, v: 3 },
  { kind: "blob", x: 240, y: 296, s: 0.9 },
  { kind: "pine", x: 380, y: 290, s: 0.95, v: 2 },
  { kind: "blob", x: 530, y: 292, s: 0.8 },
  { kind: "pine", x: 670, y: 288, s: 1.05, v: 3 },
  { kind: "pine", x: 790, y: 288, s: 0.92, v: 2 },
  { kind: "blob", x: 910, y: 292, s: 0.8 },
  { kind: "pine", x: 1040, y: 292, s: 1.0, v: 3 },
  { kind: "pine", x: 1180, y: 294, s: 1.1, v: 3 },
  { kind: "blob", x: 1300, y: 296, s: 0.9 },
];

const frontTrees: Array<{ x: number; y: number; s: number; kind: "leafy" | "pine" }> = [
  { kind: "leafy", x: 90, y: 306, s: 2.2 },
  { kind: "pine", x: 240, y: 308, s: 1.3 },
  { kind: "pine", x: 440, y: 304, s: 1.25 },
  { kind: "leafy", x: 610, y: 306, s: 1.4 },
  { kind: "pine", x: 830, y: 304, s: 1.3 },
  { kind: "pine", x: 1020, y: 306, s: 1.3 },
  { kind: "pine", x: 1200, y: 308, s: 1.35 },
  { kind: "leafy", x: 1350, y: 306, s: 2.3 },
];

const tufts: Array<[number, number]> = [
  [0, 322],
  [60, 318],
  [120, 323],
  [185, 319],
  [250, 322],
  [315, 317],
  [380, 323],
  [445, 318],
  [510, 322],
  [575, 317],
  [640, 323],
  [705, 319],
  [770, 322],
  [835, 317],
  [900, 323],
  [965, 318],
  [1030, 322],
  [1095, 317],
  [1160, 323],
  [1225, 319],
  [1290, 322],
  [1360, 318],
  [1420, 323],
];
---

<div class="scenery sticky bottom-0 z-[3] h-[160px] sm:h-[220px] md:h-[46vh] md:min-h-[300px] pointer-events-none" aria-hidden="true">
  <div class="layer trees-back absolute inset-0 w-full h-full will-change-transform" data-depth="5">
    <svg viewBox="0 0 1440 340" preserveAspectRatio="xMidYMax slice" class="block w-full h-full">
      <g fill="#101c38">
        <path d="M0 340 L0 306 Q180 288 360 300 T720 296 T1080 304 T1440 292 L1440 340 Z" />
        {
          backTrees.map((t) => (
            <g transform={`translate(${t.x},${t.y}) scale(${t.s})`}>
              <polygon points="10,-76 1,-16 19,-16" />
              <polygon points="10,-58 -2,-30 22,-30" />
              {t.v === 3 && <polygon points="10,-42 19,-16 1,-16" />}
              <rect x="8.5" y="-6" width="3" height="8" />
            </g>
          ))
        }
      </g>
    </svg>
  </div>

  <div class="layer trees-mid absolute inset-0 w-full h-full will-change-transform" data-depth="12">
    <svg viewBox="0 0 1440 340" preserveAspectRatio="xMidYMax slice" class="block w-full h-full">
      <g fill="#0a142c">
        <path d="M0 340 L0 288 Q240 272 480 282 T960 278 T1440 284 L1440 340 Z" />
        {
          midTrees.map((t) =>
            t.kind === "pine" ? (
              <g transform={`translate(${t.x},${t.y}) scale(${t.s})`}>
                <polygon points="10,-76 1,-16 19,-16" />
                <polygon points="10,-58 -2,-30 22,-30" />
                {t.v === 3 && <polygon points="10,-42 19,-16 1,-16" />}
                <rect x="8.5" y="-6" width="3" height="8" />
              </g>
            ) : (
              <g transform={`translate(${t.x},${t.y}) scale(${t.s})`}>
                <ellipse cx="0" cy="-52" rx="28" ry="26" />
                <ellipse cx="-18" cy="-42" rx="16" ry="14" />
                <ellipse cx="18" cy="-44" rx="16" ry="15" />
                <rect x="-2.5" y="-30" width="5" height="30" />
              </g>
            ),
          )
        }
      </g>
    </svg>
  </div>

  <div class="layer trees-front absolute inset-0 w-full h-full will-change-transform" data-depth="20">
    <svg viewBox="0 0 1440 340" preserveAspectRatio="xMidYMax slice" class="block w-full h-full">
      <g fill="#060d1d">
        <path d="M0 340 L0 302 Q300 292 600 300 T1200 296 T1440 302 L1440 340 Z" />
        {
          frontTrees.map((t) =>
            t.kind === "pine" ? (
              <g transform={`translate(${t.x},${t.y}) scale(${t.s})`}>
                <polygon points="10,-76 1,-16 19,-16" />
                <polygon points="10,-58 -2,-30 22,-30" />
                <polygon points="10,-42 19,-16 1,-16" />
                <rect x="8.5" y="-6" width="3" height="8" />
              </g>
            ) : (
              <g transform={`translate(${t.x},${t.y}) scale(${t.s})`}>
                <rect x="-3" y="-40" width="6" height="40" />
                <ellipse cx="0" cy="-66" rx="34" ry="32" />
                <ellipse cx="-24" cy="-52" rx="20" ry="18" />
                <ellipse cx="24" cy="-54" rx="20" ry="18" />
              </g>
            ),
          )
        }
      </g>
    </svg>
  </div>

  <div class="layer grass absolute inset-0 w-full h-full will-change-transform" data-depth="27">
    <svg viewBox="0 0 1440 340" preserveAspectRatio="xMidYMax slice" class="block w-full h-full">
      <g fill="#040a18">
        <path d="M0 340 L0 320 Q360 310 720 316 T1440 312 L1440 340 Z" />
        <g id="tuft">
          <path d="M0 0 Q-3 -10 -9 -17 Q-2 -10 -1 -1 Z" />
          <path d="M1 0 Q1 -13 -2 -22 Q3 -12 3 0 Z" />
          <path d="M2 0 Q5 -11 10 -16 Q4 -8 3 0 Z" />
          <path d="M3 0 Q5 -8 10 -10 Q5 -5 4 0 Z" />
          <path d="M0 0 Q-1 -9 -5 -11 Q0 -6 1 0 Z" />
        </g>
        {tufts.map(([x, y]) => (
          <use href="#tuft" x={x} y={y} />
        ))}
      </g>
    </svg>
  </div>
</div>
